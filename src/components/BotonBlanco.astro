---
const { href, texto, style } = Astro.props;
---

<a
  href={href}
  style={style}
  class="
    absolute

    backdrop-blur-md
    bg-black/20
    border border-white/20

    text-white/70
    text-xs

    rounded-3xl

    px-2 py-2

    transition-all
    duration-300

    hover:scale-105
    hover:text-white

    inline-block
  "
>
  {texto}
</a>