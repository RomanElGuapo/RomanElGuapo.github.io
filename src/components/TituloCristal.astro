---
const { texto } = Astro.props;
---


<div class="flex justify-center mt-15">
    <h1 class="text-6xl  
        text-transparent
        
        bg-cyan-100/10
        backdrop-blur-xs
        border border-white/10
        rounded-3xl
        px-6 py-4

        bg-clip-text
        bg-gradient-to-r
        from-cyan-200
        via-emerald-100
        to-teal-300
        font-extralight
        tracking-[0.2em]
        drop-shadow-[0_0_8px_rgba(180,255,240,0.7)]
        drop-shadow-[0_0_20px_rgba(120,255,220,0.35)]">
            {texto}
    </h1>
</div>