---
import "../styles/global.css";
import BotonBlanco from "../components/BotonBlanco.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Román Zamora Curriculum Vitae</title>
  </head>

  <body class="bg-black">

    <main class="relative w-full">

      <!-- IMAGEN -->
      <img
        src="/roman_cristal_gpt.png"
        alt="Imagen principal"
        class="w-[45%] h-auto mx-auto"
      />

      <!-- CONTENIDO ENCIMA -->
      
      <div class="absolute top-[1.3%] left-[30.9%]">

        <div
          class="backdrop-blur-sm  
                 rounded-3xl 
                 text-white/70"
        >

          <p class="mt-3 text-xs">
            Ciencias Genómicas - angelzl@lcg.unam.mx
          </p>

        </div>

      </div>

      <! --- BOTONES --- >
      <a
        href="/proyectos"
        class="
          absolute bottom-[4.5%] right-[31.55%]
          backdrop-blur-md
          bg-black/20
          border border-cyan-400/20
          hover:border-cyan-400/60
          hover:bg-cyan-400/10
          text-cyan-300
          hover:text-white
          px-1 py-0
          rounded-3xl
          transition-all
          duration-300
          hover:scale-105
          inline-block
        "
      >
        🡢
      </a>

      <a
        href="https://www.youtube.com/watch?v=1_JbJTeLZJs"
        class="
          absolute bottom-[2.9%] left-[41.1%]
          backdrop-blur-md
          bg-black/20
          border border-yellow-400/20
          hover:border-yellow-400/60
          hover:bg-yellow-400/10
          text-yellow-300
          hover:text-white
          px-1 py-0
          rounded-3xl
          transition-all
          duration-300
          hover:scale-105
          inline-block
        "
      >
        🡢
      </a>

      <BotonBlanco
        href="/trayectoria"
        texto="Trayectoria"
        posicion="top-[1.5%] right-[38%]"
      />

      <BotonBlanco
        href="/proyectos"
        texto="Proyectos"
        posicion="top-[1.5%] right-[33.4%]"
      />

      <BotonBlanco
        href="/contacto"
        texto="Contacto"
        posicion="top-[1.5%] right-[29%]"
      />

      <BotonBlanco
        href="/#"
        texto="Inicio"
        posicion="top-[1.5%] right-[43%]"
      />

    </main>

  </body>
</html>