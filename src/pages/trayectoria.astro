---
import "../styles/global.css";
import BotonBlanco from "../components/BotonBlanco.astro";
import BotonesPrincipales from "../components/BotonesPrincipales.astro";
import TituloCristal from "../components/TituloCristal.astro"
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Román Zamora Trayectoria</title>
    
  </head>
      <!IMAGEN DE FONDO>
        <div
        class="
            w-[100%]
            min-h-screen
            mx-auto

            bg-cover
            bg-center
            bg-no-repeat

            overflow-hidden

            relative
        "
        style="background-image: url('/trayectoria.png');"
        >
      <!-- CONTENIDO ENCIMA -->
    
    <TituloCristal texto="ROMÁN ZAMORA - TRAYECTORIA"/>

    <div class="absolute top-[1.3%] left-[30.9%]">

         <div
          class="backdrop-blur-sm  
                 rounded-3xl 
                 text-white/70"
        >

          <p class="mt-3 text-xs">
            Ciencias Genómicas - Bioinformática - Inteligencia Artificial
          </p>

         </div>


     </div>

         <div class="absolute top-[1.3%] left-[30.9%]">

         <div
          class="backdrop-blur-sm  
                 rounded-3xl 
                 text-white/70"
        >

          <p class="mt-3 text-xs">
            Ciencias Genómicas - Bioinformática - Inteligencia Artificial
          </p>

         </div>
     </div>

    <! --- BOTONES --- >
      <BotonesPrincipales/>
        

    <section class="text-white body-font">
    <div class="container px-5 py-24 mx-auto">
        <div class="flex flex-wrap -m-4">
        <div class="p-4 lg:w-1/3">
            <div class="h-full backdrop-blur-md px-8 pt-16 pb-24 rounded-lg overflow-hidden text-center relative">
            <h2 class="tracking-widest text-xs title-font font-medium text-gray-400 mb-1">AÑO 2023</h2>
            <h1 class="title-font sm:text-2xl text-xl font-medium text-white mb-3">Principios de programación y Bases de Biología de Sistemas</h1>
            <p class="leading-relaxed mb-3">Comienzo de mi carrera en la Licenciatura en Ciencias Genómicas, UNAM, Colaboraciones: </p>
            <p class="leading-relaxed mb-3">
            •
            <a
                href="http://freyrelab.org/es/"
                class="text-blue-400 underline hover:text-blue-300"
                target="_blank"
                rel="noopener noreferrer"
            >
                Laboratorio de Biología de Sistemas, Centro de Ciencias Genómicas, UNAM, Morelos
            </a>

            , Julio Freyre <br />

            1 año, entrenamiento en principios de redes regulatorias
            </p>

            <p class="leading-relaxed mb-3">Materias reelevantes: <br/> • Principios de programación I y II - Dr. Julio Freyre <br/> • Bioinformática I y II - Dra. Heladia Salgado <br/> • Genética - Dr. David Romero</p>

            <a 
            class="
                mt-4
                inline-flex 
                items-center

                bg-blue-600
                text-white

                px-5 py-2

                rounded-xl

                transition-all
                duration-300

                hover:bg-white
                hover:text-blue-600
            " 
            href="/proyectos"
            >
            PROYECTOS 

            <svg 
                class="w-4 h-4 ml-2" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="2" 
                fill="none" 
                stroke-linecap="round" 
                stroke-linejoin="round"
            >
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
            </svg>
            </a>
            </div>
        </div>



        <div class="p-4 lg:w-1/3">
            <div class="h-full backdrop-blur-md px-8 pt-16 pb-24 rounded-lg overflow-hidden text-center relative">
                <h2 class="tracking-widest text-xs title-font font-medium text-gray-400 mb-1">AÑO 2024</h2>
                <h1 class="title-font sm:text-2xl text-xl font-medium text-white mb-3">Familiarizandome con Herramientas avanzadas de Bioinformática</h1>
                <p class="leading-relaxed mb-3">Colaboraciones:</p>
                <p class="leading-relaxed mb-3">•
                <a href="https://www.ccg.unam.mx/genomica-computacional/" class="text-blue-400 underline hover:text-blue-300" target="_blank" rel="noopener noreferrer">
                Laboratorio de Genómica Computacional, Centro de Ciencias Genómicas, UNAM, Morelos </a>
                , Carlos Méndez <br /> 1 año, colaboración en proyectos de Machine Learning e impartición de un taller de Inteligencia Artificial
                </p>

            <p class="leading-relaxed mb-3">Materias reelevantes: <br/> • Ensamble de Genomas y filogenias - Dr. Luis Lozano / Dr. Pablo Vinuesa <br/> • Python y BioPython - Dra. Heladia Salgado <br/> • Manejo básico de servidores - Alfredo Hernández <br/>• Programación en R - Dra. Daniela Ledezma </p>

            <a 
            class="
                mt-4
                inline-flex 
                items-center

                bg-blue-600
                text-white

                px-5 py-2

                rounded-xl

                transition-all
                duration-300

                hover:bg-white
                hover:text-blue-600
            " 
            href="/proyectos"
            >
            PROYECTOS 

            <svg 
                class="w-4 h-4 ml-2" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="2" 
                fill="none" 
                stroke-linecap="round" 
                stroke-linejoin="round"
            >
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
            </svg>
            </a>
            </div>
        </div>


        <div class="p-4 lg:w-1/3">
            <div class="h-full backdrop-blur-md px-8 pt-16 pb-24 rounded-lg overflow-hidden text-center relative">
            <h2 class="tracking-widest text-xs title-font font-medium text-gray-400 mb-1">AÑO 2025</h2>
            <h1 class="title-font sm:text-2xl text-xl font-medium text-white mb-3">Primeras prácticas de conocimientos en análisis biológico</h1>
            <p class="leading-relaxed mb-3">Colaboraciones:.</p>
            <p class="leading-relaxed mb-3">
            •
            <a
                href="https://www.ibt.unam.mx/perfil/2330/dra-patricia-leon-meja"
                class="text-blue-400 underline hover:text-blue-300"
                target="_blank"
                rel="noopener noreferrer"
            >
                Departamento de Biología Molecular, Instituto de Biotecnología, UNAM, Morelos
            </a>

            , Dra. Patricia León <br /> 1 año, colaboración en proyectos de técnicas básicas de biología molecular y desarrollo de workflow para precesamiento de imágenes de Plantas con PlantCV 
            </p>

            <p class="leading-relaxed mb-3">Materias reelevantes: <br/> • Transcriptómica - Dr. David Valle <br/> • Ecuaciones Diferenciales Julio Martínez <br/> • Introducción a la Ciencia de Datos/Machine Learning Dr. Carlos Méndez <br/>• Biología de Sistemas - Dra. Daniela Ledezma / Dr. José Utrilla / Dra. Ayari Fuentes </p>
            
            <div class="flex justify-center mt-4">

            <a 
                class="
                inline-flex 
                items-center

                bg-blue-600
                text-white

                px-5 py-2

                rounded-xl

                transition-all
                duration-300

                hover:bg-white
                hover:text-blue-600
                " 
                href="/proyectos"
            >
                PROYECTOS 

                <svg 
                class="w-4 h-4 ml-2" 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="2" 
                fill="none" 
                stroke-linecap="round" 
                stroke-linejoin="round"
                >
                <path d="M5 12h14"></path>
                <path d="M12 5l7 7-7 7"></path>
                </svg>

            </a>

            </div>
        </div>
        </div>
    </div>
    </section>

    </main>
  </body>
