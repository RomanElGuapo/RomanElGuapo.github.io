---
import "../styles/global.css";
import BotonesPrincipales from "../components/BotonesPrincipales.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Román Zamora Curriculum Vitae</title>
  </head>

  <body class="bg-black">

    <main class="relative w-full h-screen overflow-hidden">

      <!-- FONDO -->
      <img
        src="/fondo_contacto.avif"
        alt="Imagen principal"
        class="
          absolute inset-0
          w-full h-full
          object-cover
          -z-10
        "
      />

      <!-- CONTENIDO -->

      <BotonesPrincipales posicion_init={15} />

      <section class="min-h-screen flex items-center justify-center px-6 py-20 bg-[#07111f] overflow-hidden">

        <!-- Glow decorativo -->
        <div class="absolute w-72 h-72 bg-cyan-400/10 blur-3xl rounded-full top-10 left-10"></div>
        <div class="absolute w-96 h-96 bg-blue-500/10 blur-3xl rounded-full bottom-0 right-0"></div>

        <div
          class="
            relative
            max-w-6xl
            w-full
            backdrop-blur-xl
            bg-white/5
            border border-white/10
            shadow-2xl
            rounded-[2rem]
            overflow-hidden
          "
        >

          <div class="container mx-auto flex px-8 py-14 md:flex-row flex-col items-center">

            <!-- Imagen -->
            <div class="lg:max-w-lg lg:w-full md:w-1/2 w-5/6 mb-10 md:mb-0 relative">

              <!-- Glow detrás de imagen -->
              <div class="absolute inset-0 bg-cyan-400/20 blur-3xl rounded-full"></div>

              <img
                class="
                  relative
                  object-cover
                  object-center
                  rounded-3xl
                  border border-white/10
                  shadow-2xl
                "
                alt="hero"
                src="/roman_base.jpg"
              >
            </div>

            <!-- Texto -->
            <div
              class="
              lg:flex-grow
              md:w-1/2
              lg:pl-20
              md:pl-16
              flex
              flex-col
              justify-start
              md:items-start
              md:text-left
              items-center
              text-center

              md:-translate-y-10
              "
            >

              <!-- Nombre -->
              <h1
                class="
                  title-font
                  sm:text-5xl
                  text-4xl
                  mb-4
                  font-semibold
                  text-white
                  tracking-tight
                "
              >
                Román Zamora
              </h1>

              <!-- Subtitulo -->
              <h2
                class="
                  text-cyan-300/80
                  text-lg
                  mb-6
                  tracking-wide
                  font-light
                "
              >
                Estudiante de Ciencias Genómicas | Bioinformática | Biología de Sistemas
              </h2>

              <!-- Línea decorativa -->
              <div class="w-24 h-[1px] bg-cyan-400/40 mb-8"></div>

              <!-- Frase -->
              <p
                class="
                  mb-10
                  leading-relaxed
                  text-gray-300
                  text-lg
                  max-w-xl
                "
              >
                En busca del diseño de sistemas biológicos. <br/>
                <br/>
                romanzamora125@gmail.com <br/>
                angelzl@lcg.unam.mx
              </p>

              <!-- Botones -->
              <div class="flex flex-wrap gap-4 justify-center md:justify-start">

                <!-- Linkedin -->
                <a
                  href="#"
                  class="
                    px-6 py-3
                    rounded-2xl
                    bg-white/5
                    border border-cyan-300/20
                    backdrop-blur-md
                    text-cyan-200
                    hover:bg-cyan-400/10
                    hover:border-cyan-300/40
                    hover:shadow-cyan-400/20
                    hover:shadow-lg
                    transition-all
                    duration-300
                  "
                >
                  LinkedIn
                </a>

                <!-- Github -->
                <a
                  href="https://github.com/romanelguapo"
                  class="
                    px-6 py-3
                    rounded-2xl
                    bg-white/5
                    border border-white/10
                    backdrop-blur-md
                    text-gray-200
                    hover:bg-white/10
                    hover:border-white/20
                    hover:shadow-lg
                    transition-all
                    duration-300
                  "
                >
                  GitHub
                </a>
              </div>

            </div>
          </div>
        </div>
      </section>

      
    </main>

  </body>
</html>