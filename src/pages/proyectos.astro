---
import "../styles/global.css";
import BotonBlanco from "../components/BotonBlanco.astro";
import BotonesPrincipales from "../components/BotonesPrincipales.astro";
import TituloCristal from "../components/TituloCristal.astro";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Román Zamora PROYECTOS</title>
  </head>

<body class="bg-white text-white overflow-x-hidden">

<!IMAGEN DE FONDO>
<div
class="w-[100%] min-h-screen mx-auto
    bg-cover bg-center bg-no-repeat
    overflow-hidden
    relative
"
style="background-image: url('/trayectoria.png');"
>
<!-- CONTENIDO ENCIMA -->

    <TituloCristal texto="ROMÁN ZAMORA - LOGROS"/>

    <div class="absolute top-[1.3%] left-[30.9%]">
        <div class="backdrop-blur-xs rounded-3xl text-white/70">
            <p class="mt-3 text-xs">
            Ciencias Genómicas - Bioinformática - Inteligencia Artificial
            </p>
        </div>
    </div>

    <! --- BOTONES --- >
    <BotonesPrincipales/>


    <section class="text-gray-600 body-font">
    <div class="container px-5 py-24 mx-auto">
        <div class="flex flex-wrap -m-4">  
        <div class="lg:w-1/3 sm:w-1/2 p-4">
            <div class="flex relative">
            <img alt="gallery" class="absolute inset-0 w-full h-full object-cover object-center" src="https://bitskingdom.sfo3.cdn.digitaloceanspaces.com/2024/09/Why-Python-Heres-Why-1024x576.webp">
            <div class="px-8 py-10 relative z-10 w-full border-4 border-gray-200 bg-white opacity-0 hover:opacity-100">
                <h2 class="tracking-widest text-sm title-font font-medium text-blue-500 mb-1">PYTHON</h2>
                <h1 class="title-font text-lg font-medium text-gray-900 mb-3">Proyectos principales</h1>
                <a class="text-blue-400 underline hover:text-blue-300 transition-colors" href="https://github.com/RomanElGuapo/Plantcv_STD_WF" target="_blank">
                Análisis de fotos de plantas (PlantCV).</a>
                <a class="text-blue-400 underline hover:text-blue-300 transition-colors" href="https://github.com/RomanElGuapo/PROYECTO_GEO" target="_blank">
                <br/>Comparación de datos de expresión de la bacteria fijadora de nitrógeno FRANKIA.</a>
                <a class="text-blue-400 underline hover:text-blue-300 transition-colors" href="https://github.com/RomanElGuapo/Implementacion_Algoritmos_Numericos" target="_blank">
                <br/>Implementación Algoritmos numéricos.</a>
            </div>
            </div>
        </div>
        <div class="lg:w-1/3 sm:w-1/2 p-4">
            <div class="flex relative">
            <img alt="gallery" class="absolute inset-0 w-full h-full object-cover object-center" src="https://vectorseek.com/wp-content/uploads/2022/02/R-Programming-Language-Logo-Vector.jpg">
            <div class="px-8 py-10 relative z-10 w-full border-4 border-gray-200 bg-white opacity-0 hover:opacity-100">
                <h2 class="tracking-widest text-sm title-font font-medium text-blue-500 mb-1">R</h2>
                <h1 class="title-font text-lg font-medium text-gray-900 mb-3">Proyectos principales</h1>
                <a class="text-blue-400 underline hover:text-blue-300 transition-colors" href="https://github.com/RomanElGuapo/Analisis_expresion_diferencial2025" target="_blank">
                Análisis de expresión diferencial de raton en condiciones de estrés.
                <br/><br/><br/></a>
            </div>
            </div>
        </div>
        <div class="lg:w-1/3 sm:w-1/2 p-4">
            <div class="flex relative">
            <img alt="gallery" class="absolute inset-0 w-full h-full object-cover object-center" src="https://orbittraining.ae/storage/2025/04/C-image.png">
            <div class="px-8 py-10 relative z-10 w-full border-4 border-gray-200 bg-white opacity-0 hover:opacity-100">
                <h2 class="tracking-widest text-sm title-font font-medium text-blue-500 mb-1">C</h2>
                <h1 class="title-font text-lg font-medium text-gray-900 mb-3">Proyectos principales</h1>
                <a class="text-blue-400 underline hover:text-blue-300 transition-colors" href="https://github.com/RomanElGuapo/Proyecto_Principios_de_Programacion2024" target="_blank">
                Principios de programación, 10 algoritmos implementados en C y Pearl.
                <br/><br/><br/></a>
            </div>
            </div>
        </div>
        <div class="lg:w-1/3 sm:w-1/2 p-4">
            <div class="flex relative">
            <img alt="gallery" class="absolute inset-0 w-full h-full object-cover object-center" src="https://miro.medium.com/1*yGD9lJMVWKI90YzwAU1Amg.png">
            <div class="px-8 py-10 relative z-10 w-full border-4 border-gray-200 bg-white opacity-0 hover:opacity-100">
                <h2 class="tracking-widest text-sm title-font font-medium text-blue-500 mb-1">BASH</h2>
                <h1 class="title-font text-lg font-medium text-gray-900 mb-3">Proyectos principales (Protegidos por politicas de privacidad)</h1>
                <p class="leading-relaxed">Ensamble del genoma de herpes <br/> Ensamble del genoma de Cupriavidus <br/> Proyecto de clusterización de secuencias.</p>
            </div>
            </div>
        </div>
        <div class="lg:w-1/3 sm:w-1/2 p-4">
            <div class="flex relative">
            <img alt="gallery" class="absolute inset-0 w-full h-full object-cover object-center" src="/linea_tiempo.png">
            <div class="px-8 py-10 relative z-10 w-full border-4 border-gray-200 bg-white opacity-0 hover:opacity-100">
                <h2 class="tracking-widest text-sm title-font font-medium text-blue-500 mb-1">Orden Cronológico</h2>
                <a class="text-blue-400 underline hover:text-blue-300 transition-colors" href="/logrosCronologico">
                Licenciatura (2023 - hoy)
                <br/><br/><br/><br/><br/><br/>.</a>
            </div>
            </div>
        </div>
        <div class="lg:w-1/3 sm:w-1/2 p-4">
            <div class="flex relative">
            <img alt="gallery" class="absolute inset-0 w-full h-full object-cover object-center" src="/diplomas.webp">
            <div class="px-8 py-10 relative z-10 w-full border-4 border-gray-200 bg-white opacity-0 hover:opacity-100">
                <h2 class="tracking-widest text-sm title-font font-medium text-blue-500 mb-1">Diplomas y Reconocimientos</h2>
                <a class="text-blue-400 underline hover:text-blue-300 transition-colors" href="/Constancia CCG 2025_Zamora López Angel Roman.pdf" target="_blank">
                Curso Desarrollo de Modelos de IA para el análisis de datos
                <br/><br/><br/><br/><br/><br/><br/><br/><br/></a>
            </div>
            </div>
        </div>
        </div>
    </div>
    </section>





</div>
</body>